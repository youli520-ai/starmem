#!/usr/bin/env python3
"""memd —— 星忆（Starmem）外挂记忆库服务

子命令:
  initdb / serve / snapshot / status
  index [--all|--bank]   重建 L1 索引
  vectorize [--all]      重建召回向量
  recall "问句"           命令行召回
  mirror-diff / mirror-resync
  turn-process           处理抽取队列

已实现：health/stats/recall/retain/turn/warm/mirror-diff。
未实现：forget、consolidate（返回 501）。
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import sqlite3
import subprocess
import sys
import time
from datetime import datetime, timezone, timedelta
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

CODE_ROOT = Path(__file__).resolve().parent.parent
ROOT = Path(os.environ.get("MEMD_ROOT") or CODE_ROOT)
DATA = ROOT / "data"
BANKS_DIR = DATA / "banks"
VEC_DIR = DATA / "vectors"
LOG_DIR = ROOT / "logs"
TMP_DIR = ROOT / "tmp"
BACKUP_ROOT = Path(os.environ.get("MEMD_BACKUP_ROOT") or (ROOT.parent / "backups" / "starmem"))
SCHEMA_VERSION = "1"
# 代码目录与数据目录解耦：MEMD_ROOT 只决定数据落点（缺省等于代码目录）
sys.path.insert(0, str(CODE_ROOT / "lib"))
import paths  # noqa: E402  路径单一入口：改环境变量即可迁移

BANKS = paths.BANKS
# 会话检索索引源：bank → Hermes state.db（会话/消息真源）
STATE_DB = {b: paths.state_db(b) for b in BANKS if b != "shared"}
STATE_DB["shared"] = paths.HERMES_HOME / "shared-state.db"
MEMORY_DIR = paths.MEMORY_DIR
TZ = timezone(timedelta(hours=8))
sys.path.insert(0, str(CODE_ROOT / "lib"))
try:
    import indexer  # 星忆索引器（lib/indexer.py）
except Exception as _exc:  # 索引器缺失不阻塞服务
    indexer = None
    print(f"WARN: indexer unavailable: {_exc}", file=sys.stderr)

try:
    import signals as signals_mod  # 星忆信号（lib/signals.py）
except Exception as _exc:  # noqa: BLE001
    signals_mod = None
    print(f"WARN: signals unavailable: {_exc}", file=sys.stderr)

try:
    import recall as recall_mod  # 星忆召回（lib/recall.py）
except Exception as _exc:
    recall_mod = None
    print(f"WARN: recall unavailable: {_exc}", file=sys.stderr)

try:
    import consolidate as consolidate_mod  # 星忆整合（lib/consolidate.py）
except Exception as _exc:
    consolidate_mod = None
    print(f"WARN: consolidate unavailable: {_exc}", file=sys.stderr)

try:
    import extract as extract_mod  # 星忆对话抽取（lib/extract.py）
except Exception as _exc:
    extract_mod = None
    print(f"WARN: extract unavailable: {_exc}", file=sys.stderr)

DDL = """
PRAGMA journal_mode=WAL;
PRAGMA foreign_keys=ON;

CREATE TABLE IF NOT EXISTS schema_meta(key TEXT PRIMARY KEY, value TEXT);

CREATE TABLE IF NOT EXISTS documents(
  id TEXT PRIMARY KEY, kind TEXT, profile TEXT, domain TEXT, path TEXT,
  content_hash TEXT, mtime REAL, created_at TEXT,
  UNIQUE(profile, path));

CREATE TABLE IF NOT EXISTS doc_entries(
  doc_id TEXT, entry_key TEXT, content_hash TEXT,
  first_seen_run TEXT, last_seen_run TEXT,
  PRIMARY KEY(doc_id, entry_key));

CREATE TABLE IF NOT EXISTS facts(
  id TEXT PRIMARY KEY, doc_id TEXT, profile TEXT, domain TEXT, scope TEXT,
  canonical_key TEXT, value TEXT,
  visibility TEXT NOT NULL DEFAULT 'private'
    CHECK(visibility IN ('shared','private','blocked')),
  target TEXT NOT NULL DEFAULT 'memory',
  source_path TEXT,
  subject TEXT, predicate TEXT, topic TEXT,
  text TEXT, origin TEXT,
  learned_at TEXT, occurred_at TEXT,
  status TEXT NOT NULL DEFAULT 'active'
    CHECK(status IN ('active','superseded','wrong','archived','deleted')),
  recallable INTEGER NOT NULL DEFAULT 1,
  no_consolidate INTEGER NOT NULL DEFAULT 0,
  raw_hash TEXT, hash TEXT,
  consolidated_at TEXT, superseded_by TEXT,
  archived_at TEXT, deleted_at TEXT,
  UNIQUE(profile, canonical_key));

CREATE TABLE IF NOT EXISTS fact_sources(
  fact_id TEXT REFERENCES facts(id) ON DELETE CASCADE,
  source_kind TEXT NOT NULL,
  doc_id TEXT, session_id TEXT, turn_id TEXT,
  quote TEXT, quote_hash TEXT, created_at TEXT,
  PRIMARY KEY(fact_id, quote_hash));

CREATE TABLE IF NOT EXISTS observations(
  id TEXT PRIMARY KEY, profile TEXT, domain TEXT, scope TEXT, visibility TEXT,
  title TEXT, body TEXT, proof_count INTEGER NOT NULL DEFAULT 0,
  last_evidence_at TEXT, last_verified_at TEXT,
  status TEXT NOT NULL DEFAULT 'fresh',
  superseded_by TEXT);

CREATE TABLE IF NOT EXISTS evidence(
  obs_id TEXT, fact_id TEXT, quote TEXT, deleted_at TEXT,
  PRIMARY KEY(obs_id, fact_id));

CREATE TABLE IF NOT EXISTS mirrors(
  profile TEXT, target TEXT, entry_hash TEXT, store TEXT, target_fact_id TEXT,
  seen_at TEXT, deleted_at TEXT,
  PRIMARY KEY(profile, target, entry_hash));

CREATE TABLE IF NOT EXISTS aliases(
  alias TEXT, canonical TEXT, kind TEXT, profile TEXT, domain TEXT);

CREATE TABLE IF NOT EXISTS shared_refs(
  bank TEXT, raw_hash TEXT, seen_at TEXT, PRIMARY KEY(bank, raw_hash));

CREATE TABLE IF NOT EXISTS recall_log(
  id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT, session_id TEXT, turn_id TEXT,
  profile TEXT, query TEXT, injected INTEGER DEFAULT 0);

CREATE TABLE IF NOT EXISTS recall_hits(
  recall_id INTEGER REFERENCES recall_log(id) ON DELETE CASCADE,
  fact_id TEXT, rank INTEGER, score REAL,
  cited INTEGER DEFAULT 0, matched_span TEXT);

CREATE TABLE IF NOT EXISTS sessions(
  session_id TEXT PRIMARY KEY, profile TEXT, started_at TEXT, last_msg_at TEXT,
  title TEXT, summary TEXT, msg_count INTEGER, indexed_at TEXT);

CREATE INDEX IF NOT EXISTS idx_facts_recall ON facts(profile, status, recallable);
CREATE INDEX IF NOT EXISTS idx_obs_scope ON observations(profile, status, scope);
CREATE INDEX IF NOT EXISTS idx_hits_recall ON recall_hits(recall_id);
CREATE INDEX IF NOT EXISTS idx_hits_fact ON recall_hits(fact_id);

-- 中文 FTS：text_seg 由 indexer 预分词后写入
CREATE VIRTUAL TABLE IF NOT EXISTS facts_fts USING fts5(fact_id UNINDEXED, text_seg);
"""


def now() -> str:
    return datetime.now(TZ).isoformat(timespec="seconds")


def bank_path(bank: str) -> Path:
    return BANKS_DIR / f"{bank}.db"


def connect(bank: str) -> sqlite3.Connection:
    conn = sqlite3.connect(bank_path(bank), timeout=5)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys=ON")
    return conn


def initdb() -> None:
    for d in (BANKS_DIR, VEC_DIR, LOG_DIR, TMP_DIR):
        d.mkdir(parents=True, exist_ok=True)
    for bank in BANKS:
        conn = connect(bank)
        conn.executescript(DDL)
        conn.execute(
            "INSERT INTO schema_meta(key,value) VALUES('schema_version',?) "
            "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
            (SCHEMA_VERSION,),
        )
        conn.execute(
            "INSERT INTO schema_meta(key,value) VALUES('bank',?) "
            "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
            (bank,),
        )
        conn.execute(
            "INSERT INTO schema_meta(key,value) VALUES('built_at',?) "
            "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
            (now(),),
        )
        conn.commit()
        conn.close()
        print(f"initdb ok: {bank_path(bank)}")


def audit_l1(bank_arg: str | None = None, as_json: bool = False) -> int:
    """只读审计 L1 文件格式。与 indexer 共用 split_sections，避免「文档口径 ≠ 入库口径」。

    硬错误（退出码 1）：文件无 ## 条目（静默不入库）、同文件内重复标题（canonical_key 冲突会互相覆盖）
    提示（不阻断）：空正文（indexer 接受，只入标题）
    """
    if indexer is None:
        print("indexer unavailable", file=sys.stderr)
        return 70
    mem_dir = indexer.MEMORY_DIR
    banks = [bank_arg] if bank_arg else [b for b in BANKS if (mem_dir / b).is_dir()]
    out: dict = {"generated_at": now(), "memory_dir": str(mem_dir), "banks": {}, "errors": [], "warnings": []}
    for bank in banks:
        d = mem_dir / bank
        if not d.is_dir():
            out["errors"].append({"bank": bank, "kind": "bank_dir_missing"})
            continue
        rows = []
        for f in sorted(d.glob("*.md")):
            secs = indexer.split_sections(f)
            titles = [t for t, _ in secs]
            dups = sorted({t for t in titles if titles.count(t) > 1})
            empties = [t for t, body in secs if not body.strip()]
            rows.append({"file": str(f), "entries": len(secs), "duplicates": dups, "empty_body": empties})
            if not secs:
                out["errors"].append({"bank": bank, "file": str(f), "kind": "no_entries"})
            if dups:
                out["errors"].append({"bank": bank, "file": str(f), "kind": "duplicate_titles", "titles": dups})
            if empties:
                out["warnings"].append({"bank": bank, "file": str(f), "kind": "empty_body", "titles": empties})
        out["banks"][bank] = {"files": len(rows), "entries": sum(r["entries"] for r in rows), "rows": rows}
    out["ok"] = not out["errors"]

    if as_json:
        print(json.dumps(out, ensure_ascii=False, indent=1))
    else:
        print(f"星忆 L1 审计  {out['generated_at']}")
        for bank, s in out["banks"].items():
            print(f"  [{bank}] {s['files']} 文件 / {s['entries']} 条目")
        if out["errors"]:
            print(f"\n错误 {len(out['errors'])} 项（会导致条目静默不入库或互相覆盖）：")
            for e in out["errors"]:
                detail = f" 标题={e['titles']}" if e.get("titles") else ""
                print(f"  ✗ {e['bank']}/{Path(e['file']).name if e.get('file') else '<bank 目录缺失>'}  {e['kind']}{detail}")
        if out["warnings"]:
            print(f"\n提示 {len(out['warnings'])} 项（不阻断）：")
            for w in out["warnings"]:
                print(f"  · {w['bank']}/{Path(w['file']).name}  空正文 {len(w['titles'])} 条")
        if not out["errors"] and not out["warnings"]:
            print("  全部通过")
    return 0 if out["ok"] else 1


def bank_stats(bank: str) -> dict:
    conn = connect(bank)
    try:
        def count(table: str) -> int:
            return conn.execute(f"SELECT count(*) FROM {table}").fetchone()[0]
        meta = dict(conn.execute("SELECT key,value FROM schema_meta").fetchall())
        return {
            "bank": bank,
            "schema_version": meta.get("schema_version"),
            "facts": count("facts"),
            "observations": count("observations"),
            "documents": count("documents"),
            "sessions": count("sessions"),
            "recall_log": count("recall_log"),
        }
    finally:
        conn.close()


def snapshot(out_root: str | None = None) -> None:
    root = Path(out_root) if out_root else BACKUP_ROOT
    gen = datetime.now(TZ).strftime("%Y%m%dT%H%M%S")
    target = root / gen
    tmp = target.with_suffix(".tmp")
    tmp.mkdir(parents=True, exist_ok=False)
    manifest = {"generation": gen, "schema_version": SCHEMA_VERSION, "banks": {}}
    for bank in BANKS:
        src = connect(bank)
        dst_path = tmp / f"{bank}.db"
        dst = sqlite3.connect(dst_path)
        try:
            src.backup(dst)
            dst.commit()
        finally:
            dst.close()
            src.close()
        h = hashlib.sha256(dst_path.read_bytes()).hexdigest()
        st = bank_stats(bank)
        manifest["banks"][bank] = {
            "file": dst_path.name,
            "sha256": h,
            "facts": st["facts"],
            "observations": st["observations"],
            "documents": st["documents"],
        }
    (tmp / "manifest.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8"
    )
    tmp.rename(target)
    print(f"snapshot ok: {target}")


def _check_token(handler: BaseHTTPRequestHandler) -> bool:
    token = os.environ.get("MEMD_TOKEN", "")
    if not token:
        # 未配置 token：只允许本机回环
        return handler.client_address[0] in ("127.0.0.1", "::1")
    auth = handler.headers.get("Authorization", "")
    return auth == f"Bearer {token}"


class Handler(BaseHTTPRequestHandler):
    server_version = "memd/0.1"
    started = time.time()

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (now(), fmt % args))

    def _json(self, code: int, payload: dict) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _auth(self) -> bool:
        if _check_token(self):
            return True
        self._json(401, {"error": "unauthorized"})
        return False

    def do_GET(self):
        if self.path == "/v1/health":
            if not self._auth():
                return
            banks = {}
            for b in BANKS:
                try:
                    banks[b] = bank_stats(b)["facts"]
                except Exception as exc:
                    banks[b] = f"error: {exc}"
            self._json(200, {
                "status": "ok",
                "version": "0.1",
                "schema_version": SCHEMA_VERSION,
                "banks": banks,
                "uptime_s": round(time.time() - self.started, 1),
                "ts": now(),
            })
        elif self.path == "/v1/stats":
            if not self._auth():
                return
            self._json(200, {"banks": [bank_stats(b) for b in BANKS], "ts": now()})
        elif self.path.startswith("/v1/mirror/diff"):
            if not self._auth():
                return
            bank = "default"
            if "?" in self.path:
                from urllib.parse import parse_qs, urlparse

                qs = parse_qs(urlparse(self.path).query)
                bank = (qs.get("bank") or ["default"])[0]
            self._json(200, indexer.mirror_diff(bank))
        elif self.path.startswith("/v1/signals"):
            if not self._auth():
                return
            from urllib.parse import parse_qs, urlparse

            qs = parse_qs(urlparse(self.path).query)
            bank = (qs.get("bank") or ["default"])[0]
            if bank not in BANKS:
                self._json(400, {"error": "bad_bank"})
                return
            if signals_mod is None:
                self._json(503, {"error": "signals_unavailable"})
                return
            try:
                rows = signals_mod.list_open(bank)
            except Exception as exc:  # noqa: BLE001
                self._json(500, {"error": f"{type(exc).__name__}: {exc}"})
                return
            self._json(200, {"bank": bank, "items": rows, "count": len(rows), "ts": now()})
        elif self.path.startswith("/v1/session_recall"):
            # 星忆承载的会话消息级检索：索引在 data/vectors/session_<bank>.npz，
            # 打分手感与旧 semantic_recall 完全一致（同一套 dense+BM25 RRF），
            # 由 emb venv 执行（memd 自身无 numpy/fastembed）。
            if not self._auth():
                return
            from urllib.parse import parse_qs, urlparse

            qs = parse_qs(urlparse(self.path).query)
            bank = (qs.get("bank") or ["default"])[0]
            q = (qs.get("q") or [""])[0]
            try:
                k = int((qs.get("k") or ["3"])[0])
            except ValueError:
                self._json(400, {"error": "bad_k"})
                return
            if bank not in BANKS or not q:
                self._json(400, {"error": "bad_bank_or_query"})
                return
            idx = ROOT / "data" / "vectors" / f"session_{bank}.npz"
            if not idx.exists():
                self._json(404, {"error": "no_session_index", "bank": bank})
                return
            env = {**os.environ,
                   "SEM_IDX": str(idx),
                   "SEM_DB": str(STATE_DB[bank]) if bank in STATE_DB else
                   str(Path.home() / ".hermes" / "state.db"),
                   "HF_ENDPOINT": "https://hf-mirror.com"}
            try:
                r = subprocess.run(
                    [os.environ.get("MEMD_EMB_PYTHON") or str(paths.EMB_PYTHON),
                     os.environ.get("MEMD_SESSION_RECALL_PY") or str(paths.BASE / "scripts" / "session_recall.py"),
                     q, str(k)],
                    env=env, capture_output=True, text=True, timeout=120,
                )
            except Exception as exc:  # noqa: BLE001
                self._json(500, {"error": f"{type(exc).__name__}: {exc}"})
                return
            items = []
            for line in (r.stdout or "").splitlines():
                parts = [x.strip() for x in line.split("|")]
                if len(parts) >= 4:
                    raw = parts[3]
                    score = raw.split()[0] if raw.split() else ""
                    items.append({"session_id": parts[0], "date": parts[1],
                                  "title": parts[2], "score": score,
                                  "nom": "强提名" in raw})
            self._json(200, {"bank": bank, "query": q, "items": items,
                             "rc": r.returncode, "ts": now()})
        else:
            self._json(404, {"error": "not_found"})

    def do_POST(self):
        if not self._auth():
            return
        if self.path == "/v1/retain":
            body = {}
            try:
                n = int(self.headers.get("Content-Length") or 0)
                if n:
                    body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                body = {}
            bank = body.get("profile") or "default"
            try:
                out = indexer.index_bank_l0(bank)
            except Exception as exc:
                self._json(500, {"error": str(exc)})
                return
            self._json(200, {"ok": True, **out,
                             "action": body.get("action"), "target": body.get("target")})
            return
        if self.path == "/v1/warm":
            try:
                m = recall_mod.model()
                for b in BANKS:
                    recall_mod._load_vectors(b)
            except Exception as exc:
                self._json(500, {"error": str(exc)})
                return
            self._json(200, {"ok": True, "model": bool(m)})
            return
        if self.path == "/v1/turn":
            body = {}
            try:
                n = int(self.headers.get("Content-Length") or 0)
                if n:
                    body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                body = {}
            bank = body.get("profile") or "default"
            try:
                out = extract_mod.enqueue(
                    bank,
                    body.get("session_id", ""),
                    body.get("turn_id", ""),
                    body.get("user", ""),
                    body.get("assistant", ""),
                )
            except Exception as exc:
                self._json(500, {"error": str(exc)})
                return
            self._json(200, {"ok": True, **out})
            return
        if self.path == "/v1/recall":
            body = {}
            try:
                n = int(self.headers.get("Content-Length") or 0)
                if n:
                    body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                body = {}
            bank = body.get("profile") or "default"
            try:
                out = recall_mod.recall(
                    bank,
                    body.get("query", ""),
                    int(body.get("budget_tokens") or 400),
                    int(body.get("max_items") or 2),
                )
            except Exception as exc:
                self._json(500, {"error": str(exc)})
                return
            try:
                conn = connect(bank)
                cur = conn.execute(
                    "INSERT INTO recall_log(ts,session_id,turn_id,profile,query,injected) VALUES(?,?,?,?,?,?)",
                    (now(), body.get("session_id", ""), body.get("turn_id", ""), bank,
                     out["query"][:500], len(out["items"])),
                )
                rid = cur.lastrowid
                for i, it in enumerate(out["items"], 1):
                    conn.execute(
                        "INSERT INTO recall_hits(recall_id,fact_id,rank,score) VALUES(?,?,?,?)",
                        (rid, it["fact_id"], i, it["score"]),
                    )
                conn.commit()
                conn.close()
            except Exception:
                pass
            self._json(200, out)
            return
        if self.path == "/v1/signals/close":
            body = {}
            try:
                n = int(self.headers.get("Content-Length") or 0)
                if n:
                    body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                body = {}
            if signals_mod is None:
                self._json(503, {"error": "signals_unavailable"})
                return
            out = signals_mod.close(str(body.get("id") or ""),
                                    str(body.get("status") or "done"),
                                    str(body.get("result") or ""))
            self._json(200 if out.get("ok") else 404, out)
            return

        if self.path == "/v1/forget":
            body = {}
            try:
                n = int(self.headers.get("Content-Length") or 0)
                if n:
                    body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                body = {}
            bank = body.get("profile") or "default"
            raw = body.get("raw_hash") or body.get("hash") or ""
            hard = bool(body.get("hard"))
            if bank not in BANKS or not raw:
                self._json(400, {"error": "bad_request"})
                return
            conn = connect(bank)
            try:
                rows = conn.execute(
                    "SELECT id FROM facts WHERE profile=? AND raw_hash=?", (bank, raw)
                ).fetchall()
                for r in rows:
                    if hard:
                        conn.execute("DELETE FROM fact_sources WHERE fact_id=?", (r["id"],))
                        conn.execute("DELETE FROM facts WHERE id=?", (r["id"],))
                    else:
                        conn.execute(
                            "UPDATE facts SET status='deleted', recallable=0, deleted_at=? WHERE id=?",
                            (now(), r["id"]),
                        )
                        conn.execute("UPDATE evidence SET deleted_at=? WHERE fact_id=?", (now(), r["id"]))
                conn.commit()
            finally:
                conn.close()
            self._json(200, {"ok": True, "affected": len(rows), "hard": hard})
            return
        if self.path == "/v1/consolidate":
            body = {}
            try:
                n = int(self.headers.get("Content-Length") or 0)
                if n:
                    body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                body = {}
            bank = body.get("profile") or "default"
            if bank not in BANKS:
                self._json(400, {"error": "bad_request"})
                return
            try:
                out = consolidate_mod.consolidate(bank)
            except Exception as exc:
                self._json(500, {"error": str(exc)})
                return
            self._json(200, {"ok": True, **out})
            return
        self._json(404, {"error": "not_found"})


def serve(port: int, bind: str) -> None:
    for d in (BANKS_DIR, LOG_DIR):
        d.mkdir(parents=True, exist_ok=True)
    lock_path = TMP_DIR / "memd.lock"
    TMP_DIR.mkdir(parents=True, exist_ok=True)
    lock_fd = open(lock_path, "w")
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("memd already running (lock held)", file=sys.stderr)
        sys.exit(75)
    if not os.environ.get("MEMD_TOKEN"):
        print("WARN: MEMD_TOKEN unset; only loopback clients allowed", file=sys.stderr)
    if extract_mod is not None:
        extract_mod.start_worker(BANKS)

    if indexer is not None:
        import threading

        def _watch() -> None:
            last: dict[str, float] = {}
            while True:
                for bank in BANKS:
                    d = MEMORY_DIR / bank
                    if d.is_dir():
                        changed = False
                        for f in d.glob("*.md"):
                            try:
                                m = f.stat().st_mtime
                            except OSError:
                                continue
                            if last.get(str(f)) != m:
                                last[str(f)] = m
                                changed = True
                        if changed:
                            try:
                                indexer.index_bank(bank)
                                print(f"watcher: L1 {bank}", file=sys.stderr)
                            except Exception as exc:
                                print(f"watcher: L1 {bank} failed: {exc}", file=sys.stderr)
                    l0_changed = False
                    for lp, _t in indexer.l0_paths(bank):
                        try:
                            m = lp.stat().st_mtime
                        except OSError:
                            continue
                        if last.get(str(lp)) != m:
                            last[str(lp)] = m
                            l0_changed = True
                    if l0_changed:
                        try:
                            indexer.index_bank_l0(bank)
                            print(f"watcher: L0 {bank}", file=sys.stderr)
                        except Exception as exc:
                            print(f"watcher: L0 {bank} failed: {exc}", file=sys.stderr)
                import time as _t

                _t.sleep(5)

        threading.Thread(target=_watch, name="starmem-watcher", daemon=True).start()

    srv = ThreadingHTTPServer((bind, port), Handler)
    print(f"memd listening on {bind}:{port} schema={SCHEMA_VERSION}", file=sys.stderr)
    try:
        srv.serve_forever()
    finally:
        srv.server_close()


def main() -> None:
    ap = argparse.ArgumentParser(prog="memd")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("initdb")
    p_serve = sub.add_parser("serve")
    p_serve.add_argument("--port", type=int, default=int(os.environ.get("MEMD_PORT", "9910")))
    p_serve.add_argument("--bind", default=os.environ.get("MEMD_BIND", "127.0.0.1"))
    p_index = sub.add_parser("index")
    p_index.add_argument("--bank", default=None)
    p_index.add_argument("--all", action="store_true")
    p_vec = sub.add_parser("vectorize")
    p_vec.add_argument("--bank", default=None)
    p_vec.add_argument("--all", action="store_true")
    p_rec = sub.add_parser("recall")
    p_rec.add_argument("query")
    p_rec.add_argument("--bank", default="default")
    p_rec.add_argument("--budget", type=int, default=400)
    p_forget = sub.add_parser("forget")
    p_forget.add_argument("raw_hash")
    p_forget.add_argument("--bank", default="default")
    p_forget.add_argument("--hard", action="store_true")
    p_con = sub.add_parser("consolidate")
    p_con.add_argument("--bank", default="default")
    p_tp = sub.add_parser("turn-process")
    p_tp.add_argument("--bank", default="default")
    sub.add_parser("mirror-diff")
    sub.add_parser("mirror-resync")
    p_snap = sub.add_parser("snapshot")
    p_snap.add_argument("--out", default=None)
    p_audit = sub.add_parser("audit")
    p_audit.add_argument("--bank", default=None)
    p_audit.add_argument("--json", action="store_true")
    p_audit.add_argument("--e2e", action="store_true", help="跑端到端验收（临时库，不进生产）")
    sub.add_parser("status")
    args = ap.parse_args()

    if args.cmd == "initdb":
        initdb()
    elif args.cmd == "serve":
        serve(args.port, args.bind)
    elif args.cmd == "audit":
        if args.e2e:
            exe = ROOT / "bin" / "starmem-e2e"
            if not exe.exists():
                print(f"e2e 脚本缺失：{exe}", file=sys.stderr)
                sys.exit(70)
            cmd = [sys.executable, str(exe)] + (["--json"] if args.json else [])
            sys.exit(subprocess.run(cmd).returncode)
        sys.exit(audit_l1(args.bank, args.json))
    elif args.cmd == "index":
        if indexer is None:
            print("indexer unavailable", file=sys.stderr)
            sys.exit(70)
        import json as _json

        if args.all or not args.bank:
            print(_json.dumps(indexer.index_all(), ensure_ascii=False, indent=2))
        else:
            print(_json.dumps(indexer.index_bank(args.bank), ensure_ascii=False, indent=2))
        # INDEX.md 随索引一并重建（2026-11-26 收编）；失败不阻断索引，信息走 stderr 保持不变 stdout 契约
        try:
            _info = indexer.rebuild_index_file()
            print("index_file: " + _json.dumps(_info, ensure_ascii=False), file=sys.stderr)
        except Exception as _exc:  # noqa: BLE001
            print(f"index_file rebuild failed: {_exc}", file=sys.stderr)
    elif args.cmd == "vectorize":
        import json as _json

        if args.all or not args.bank:
            print(_json.dumps([recall_mod.build_vectors(b) for b in BANKS], ensure_ascii=False, indent=2))
        else:
            print(_json.dumps(recall_mod.build_vectors(args.bank), ensure_ascii=False, indent=2))
    elif args.cmd == "recall":
        import json as _json

        print(_json.dumps(recall_mod.recall(args.bank, args.query, args.budget), ensure_ascii=False, indent=2))
    elif args.cmd == "forget":
        import json as _json
        import urllib.request as _u

        payload = _json.dumps(
            {"profile": args.bank, "raw_hash": args.raw_hash, "hard": args.hard}
        ).encode()
        req = _u.Request(
            f"http://127.0.0.1:{os.environ.get('MEMD_PORT', '9910')}/v1/forget",
            data=payload, headers={"Content-Type": "application/json"}, method="POST",
        )
        print(_u.urlopen(req, timeout=5).read().decode())
    elif args.cmd == "consolidate":
        import json as _json

        print(_json.dumps(consolidate_mod.consolidate(args.bank), ensure_ascii=False, indent=2))
    elif args.cmd == "turn-process":
        import json as _json

        print(_json.dumps(extract_mod.process_pending(args.bank), ensure_ascii=False, indent=2))
    elif args.cmd == "mirror-diff":
        import json as _json

        print(_json.dumps([indexer.mirror_diff(b) for b in BANKS], ensure_ascii=False, indent=2))
    elif args.cmd == "mirror-resync":
        import json as _json

        print(_json.dumps([indexer.index_bank_l0(b) for b in BANKS], ensure_ascii=False, indent=2))
    elif args.cmd == "snapshot":
        snapshot(args.out)
    elif args.cmd == "status":
        print(json.dumps([bank_stats(b) for b in BANKS], ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
